<?xml version="1.0"?>
<package format="3">
  <name>prime_contact_id_ros</name>
  <version>0.1.0</version>
  <description>ROS2 bridge for local PRIME moving window inertial-parameter identification.</description>
  <maintainer email="contact-id-maintainers@example.com">Contact-ID Maintainers</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>pinocchio</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>diagnostic_msgs</depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>unitree_go</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rosbag2</exec_depend>
  <exec_depend>iekf_go1</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
